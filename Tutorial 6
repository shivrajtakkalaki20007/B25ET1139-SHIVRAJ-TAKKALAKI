
#include <iostream>
using namespace std;

class Complex {
    int real, imag;

public:
    Complex(int r = 0, int i = 0) {
        real = r;
        imag = i;
    }

    Complex operator+(int n) {
        return Complex(real + n, imag);
    }

    void display() {
        cout << real << " + " << imag << "i";
    }
};

int main() {
    Complex c1(5, 3);
    int n = 4;

    Complex c2 = c1 + n;

    cout << "Result: ";
    c2.display();

    return 0;
}

