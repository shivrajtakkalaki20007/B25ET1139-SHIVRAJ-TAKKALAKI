
#include <iostream>
using namespace std;

int main() {
    int a, b;

    cout << "Enter two numbers: ";
    cin >> a >> b;

    try {
        try {
            if (b == 0)
                throw b;

            cout << "Division = " << a / b << endl;
        }
        catch (int) {
            cout << "Inner catch: Division by zero!" << endl;
            throw;
        }
    }
    catch (...) {
        cout << "Outer catch: Invalid arithmetic operation!" << endl;
    }

    return 0;
}
